# Angular's build-time configuration lives in src/environments/ (environment.ts /
# environment.prod.ts), NOT in this file — the Angular CLI does not read .env at build time.
# This file only supplies process environment variables to the dev container
# (see ../docker-compose.yml's frontend service `env_file`).

# Disable Angular CLI usage analytics collection in local/dev containers.
NG_CLI_ANALYTICS=false
